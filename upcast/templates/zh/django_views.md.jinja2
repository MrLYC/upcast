{% extends "base.md.jinja2" %}

{% block summary %}
{{ super() }}
- **视图总数**: {{ summary.total_views }}
- **动作总数**: {{ summary.total_actions }}
{% endblock %}

{% block results %}
{% for view_id, view in results.items() %}

### {{ view_id }}

- **类型**: {{ view.kind }}
- **来源**: `{{ view.file }}:{{ view.line }}`
- **识别状态**: {{ view.recognition.status }}

{% if view.route_refs %}
#### 路由引用

| 类型 | 状态 | 路径 / 前缀 | 路由器 |
|------|------|-------------|--------|
{% for route in view.route_refs %}
| {{ route.kind }} | {{ route.status }} | {{ route.pattern or route.prefix or '-' }} | {{ route.router_type or '-' }} |
{% endfor %}
{% endif %}

#### 安全证据

- 认证: {{ view.security.authentication.state }}
- 授权: {{ view.security.authorization.state }}
- CSRF: {{ view.security.csrf.state }}
{% if view.security.raw_signals %}
- 原始信号: {% for signal in view.security.raw_signals %}`{{ signal.expression }}`{% if not loop.last %}, {% endif %}{% endfor %}
{% endif %}

{% if view.model_usages %}
#### 模型使用

| 模型 | 角色 | 操作 | 状态 |
|------|------|------|------|
{% for usage in view.model_usages %}
| {{ usage.model or '-' }} | {{ usage.role }} | {{ usage.operation }} | {{ usage.evidence.status }} |
{% endfor %}
{% endif %}

{% if view.actions %}
#### 动作

| 动作 | 来源 | HTTP 方法 | Detail | 授权 |
|------|------|-----------|--------|------|
{% for action in view.actions %}
| {{ action.name }} | {{ action.origin }} | {{ action.methods | join(', ') or '-' }} | {{ action.detail if action.detail is not none else '-' }} | {{ action.security.authorization.state }} |
{% endfor %}
{% endif %}

---
{% endfor %}

{% if unresolved_route_references %}
### 未解析路由引用

| 状态 | 路径 | 表达式 |
|------|------|--------|
{% for route in unresolved_route_references %}
| {{ route.status }} | {{ route.pattern or '-' }} | {% if route.evidence %}`{{ route.evidence[0].expression }}`{% else %}-{% endif %} |
{% endfor %}
{% endif %}
{% endblock %}
